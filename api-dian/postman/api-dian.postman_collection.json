{
  "info": {
    "name": "api-dian",
    "description": "Pruebas manuales de la API de api-dian (Fase 2.7). El certificado embebido en 'Crear emisor' es uno autofirmado generado solo para pruebas (no es el certificado real de la DIAN) — sirve para construir y firmar XML localmente, nunca para enviar a la DIAN de verdad. Los requests están encadenados con variables de colección: corre las carpetas en orden y cada paso captura automáticamente los IDs que necesita el siguiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "issuerId", "value": "" },
    { "key": "invoiceRangeId", "value": "" },
    { "key": "creditNoteRangeId", "value": "" },
    { "key": "debitNoteRangeId", "value": "" },
    { "key": "invoiceDocumentId", "value": "" },
    { "key": "invoicePrefix", "value": "" },
    { "key": "invoiceCufe", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "1. Issuers",
      "item": [
        {
          "name": "POST Crear emisor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('issuerId', body.id);",
                  "    console.log('issuerId =', body.id);",
                  "}",
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "pm.test('nunca expone secretos', () => {",
                  "    return !('certificate_base64' in body) && !('software_pin' in body) && !('certificate_password' in body);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nit\": \"900373076\",\n  \"check_digit\": \"1\",\n  \"business_name\": \"Empresa de Prueba Postman S.A.S.\",\n  \"identification_type_code\": \"NIT\",\n  \"department_code\": \"11\",\n  \"municipality_code\": \"11001\",\n  \"address_line\": \"Calle 1 # 2-3\",\n  \"email\": \"facturacion@empresa.test\",\n  \"environment\": \"1\",\n  \"software_id\": \"software-id-de-prueba\",\n  \"software_pin\": \"12345\",\n  \"certificate_base64\": \"\",\n  \"certificate_password\": \"clave-de-prueba\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/issuers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "issuers"] }
          }
        },
        {
          "name": "GET Consultar emisor",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/issuers/{{issuerId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "issuers", "{{issuerId}}"] }
          }
        }
      ]
    },
    {
      "name": "2. Numbering Ranges",
      "item": [
        {
          "name": "POST Crear rango - Invoice (01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('invoiceRangeId', body.id); }",
                  "pm.test('201 Created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dian_document_type_code\": \"01\",\n  \"prefix\": \"SETP\",\n  \"resolution_number\": \"18760000001\",\n  \"resolution_date\": \"2024-01-01\",\n  \"range_from\": 1,\n  \"range_to\": 5000,\n  \"valid_from\": \"2024-01-01\",\n  \"valid_to\": \"2026-01-01\",\n  \"environment\": \"1\",\n  \"technical_key\": \"clave-tecnica-de-prueba\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/issuers/{{issuerId}}/numbering-ranges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "issuers", "{{issuerId}}", "numbering-ranges"]
            }
          }
        },
        {
          "name": "POST Crear rango - Nota Crédito (91)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('creditNoteRangeId', body.id); }",
                  "pm.test('201 Created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dian_document_type_code\": \"91\",\n  \"prefix\": \"SETPNC\",\n  \"resolution_number\": \"18760000002\",\n  \"resolution_date\": \"2024-01-01\",\n  \"range_from\": 1,\n  \"range_to\": 5000,\n  \"valid_from\": \"2024-01-01\",\n  \"valid_to\": \"2026-01-01\",\n  \"environment\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/issuers/{{issuerId}}/numbering-ranges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "issuers", "{{issuerId}}", "numbering-ranges"]
            }
          }
        },
        {
          "name": "POST Crear rango - Nota Débito (92)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('debitNoteRangeId', body.id); }",
                  "pm.test('201 Created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dian_document_type_code\": \"92\",\n  \"prefix\": \"SETPND\",\n  \"resolution_number\": \"18760000003\",\n  \"resolution_date\": \"2024-01-01\",\n  \"range_from\": 1,\n  \"range_to\": 5000,\n  \"valid_from\": \"2024-01-01\",\n  \"valid_to\": \"2026-01-01\",\n  \"environment\": \"1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/issuers/{{issuerId}}/numbering-ranges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "issuers", "{{issuerId}}", "numbering-ranges"]
            }
          }
        },
        {
          "name": "GET Consultar rango (Invoice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/numbering-ranges/{{invoiceRangeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "numbering-ranges", "{{invoiceRangeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Documents",
      "item": [
        {
          "name": "POST Emitir Factura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('invoiceDocumentId', body.id);",
                  "    pm.collectionVariables.set('invoicePrefix', body.prefix);",
                  "    pm.collectionVariables.set('invoiceCufe', body.document_key);",
                  "}",
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "pm.test('status built (no se envió a la DIAN — sin red real)', () => body.status === 'built');",
                  "pm.test('XML firmado (contiene ds:Signature)', () => body.signed_xml.includes('<ds:Signature'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuer_id\": \"{{issuerId}}\",\n  \"numbering_range_id\": \"{{invoiceRangeId}}\",\n  \"customer\": {\n    \"identification\": { \"number\": \"222222222222\", \"type_code\": \"13\" },\n    \"name\": \"Consumidor Final\"\n  },\n  \"lines\": [\n    {\n      \"description\": \"Servicio de prueba (Postman)\",\n      \"quantity\": 1,\n      \"unit_code\": \"94\",\n      \"line_extension_cents\": 10000,\n      \"unit_price_cents\": 10000,\n      \"taxes\": [\n        { \"taxable_amount_cents\": 10000, \"tax_amount_cents\": 0, \"percent\": 0, \"type_code\": \"01\", \"type_name\": \"IVA\" }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/invoices", "host": ["{{baseUrl}}"], "path": ["api", "v1", "invoices"] }
          }
        },
        {
          "name": "POST Emitir Nota Crédito (referencia la Factura)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuer_id\": \"{{issuerId}}\",\n  \"numbering_range_id\": \"{{creditNoteRangeId}}\",\n  \"customer\": {\n    \"identification\": { \"number\": \"222222222222\", \"type_code\": \"13\" },\n    \"name\": \"Consumidor Final\"\n  },\n  \"lines\": [\n    {\n      \"description\": \"Anulación de servicio de prueba (Postman)\",\n      \"quantity\": 1,\n      \"unit_code\": \"94\",\n      \"line_extension_cents\": 10000,\n      \"unit_price_cents\": 10000,\n      \"taxes\": [\n        { \"taxable_amount_cents\": 10000, \"tax_amount_cents\": 0, \"percent\": 0, \"type_code\": \"01\", \"type_name\": \"IVA\" }\n      ]\n    }\n  ],\n  \"credit_note_type_code\": \"2\",\n  \"billing_reference\": {\n    \"prefix\": \"{{invoicePrefix}}\",\n    \"number\": \"1\",\n    \"cufe\": \"{{invoiceCufe}}\",\n    \"issue_date\": \"2026-06-20\"\n  },\n  \"discrepancy_response\": {\n    \"reference_id\": \"{{invoicePrefix}}1\",\n    \"response_code\": \"2\",\n    \"description\": \"Anulación de factura electrónica\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/credit-notes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "credit-notes"] }
          }
        },
        {
          "name": "POST Emitir Nota Débito (referencia la Factura)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issuer_id\": \"{{issuerId}}\",\n  \"numbering_range_id\": \"{{debitNoteRangeId}}\",\n  \"customer\": {\n    \"identification\": { \"number\": \"222222222222\", \"type_code\": \"13\" },\n    \"name\": \"Consumidor Final\"\n  },\n  \"lines\": [\n    {\n      \"description\": \"Intereses por mora (Postman)\",\n      \"quantity\": 1,\n      \"unit_code\": \"94\",\n      \"line_extension_cents\": 10000,\n      \"unit_price_cents\": 10000,\n      \"taxes\": [\n        { \"taxable_amount_cents\": 10000, \"tax_amount_cents\": 0, \"percent\": 0, \"type_code\": \"01\", \"type_name\": \"IVA\" }\n      ]\n    }\n  ],\n  \"billing_reference\": {\n    \"prefix\": \"{{invoicePrefix}}\",\n    \"number\": \"1\",\n    \"cufe\": \"{{invoiceCufe}}\",\n    \"issue_date\": \"2026-06-20\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/debit-notes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "debit-notes"] }
          }
        },
        {
          "name": "GET Consultar documento (Factura)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/{{invoiceDocumentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "documents", "{{invoiceDocumentId}}"]
            }
          }
        }
      ]
    }
  ]
}
