# ──────────────────────────────────────────────
# api-dian — variables de entorno
# Copia este archivo como .env y completa los valores
# ──────────────────────────────────────────────

# Entorno: development | staging | production
APP_ENV=development

# Nombre del servicio (aparece en logs)
SERVICE_NAME=api-dian

# ── Servidor HTTP ──────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Base de datos PostgreSQL ───────────────────
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=require
DATABASE_URL=postgres://usuario:contraseña@host:5432/api_dian?sslmode=require

# Tamaño del pool de conexiones
DATABASE_MAX_CONN=25
DATABASE_MIN_CONN=5

# ── Logging ────────────────────────────────────
# Niveles: debug | info | warn | error
LOG_LEVEL=info

# ── Secretos de emisores (internal/issuers) ────
# Cifra software_pin/certificate/certificate_password con AES-256-GCM antes de guardarlos.
# 32 bytes en base64. Generar con: openssl rand -base64 32
# Si se pierde o se cambia, los emisores ya guardados quedan ilegibles — no hay forma de
# recuperarlos sin la clave original.
ISSUER_SECRETS_KEY=

# ── Autenticación (internal/auth) ──────────────
# Firma los tokens de sesión (JWT, HS256). Mínimo 32 bytes en base64.
# Generar con: openssl rand -base64 32
# Deliberadamente distinta de ISSUER_SECRETS_KEY — una cifra datos en reposo, la otra firma
# tokens; no deben compartir clave. Si se cambia, todas las sesiones activas se invalidan.
AUTH_JWT_SECRET=
