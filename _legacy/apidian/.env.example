# ──────────────────────────────────────────────
# apidian — variables de entorno
# Copia este archivo como .env y completa los valores
# ──────────────────────────────────────────────

# Entorno: development | staging | production
APP_ENV=development

# Nombre del servicio (aparece en logs)
SERVICE_NAME=apidian

# ── Servidor HTTP ──────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Base de datos PostgreSQL ───────────────────
# Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=require
DATABASE_URL=postgres://usuario:contraseña@host:5432/apidian?sslmode=require

# Tamaño del pool de conexiones
DATABASE_MAX_CONN=25
DATABASE_MIN_CONN=5

# ── Logging ────────────────────────────────────
# Niveles: debug | info | warn | error
LOG_LEVEL=info

# ── Secretos de emisores (internal/issuers) ────
# Cifra software_pin/certificate/certificate_password con AES-256-GCM antes de guardarlos.
# 32 bytes en base64. Generar con: openssl rand -base64 32
# Si se pierde o se cambia, los emisores ya guardados quedan ilegibles — no hay forma de
# recuperarlos sin la clave original.
ISSUER_SECRETS_KEY=

# ── Autenticación (internal/auth) ──────────────
# Firma los tokens de sesión (JWT, HS256). Mínimo 32 bytes en base64.
# Generar con: openssl rand -base64 32
# Deliberadamente distinta de ISSUER_SECRETS_KEY — una cifra datos en reposo, la otra firma
# tokens; no deben compartir clave. Si se cambia, todas las sesiones activas se invalidan.
AUTH_JWT_SECRET=

# ── CORS (frontend en el navegador) ────────────
# Orígenes permitidos para llamar a esta API desde un navegador (scheme+host+puerto exacto),
# separados por coma. Sin esto, un frontend en el navegador queda bloqueado por CORS aunque la
# petición sí le llegue al servidor — curl/Postman/llamadas servidor-a-servidor no se ven
# afectados, CORS solo lo aplica el navegador.
# Ejemplo: CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000
# "*" permite cualquier origen — SOLO para desarrollo local, nunca en producción.
CORS_ALLOWED_ORIGINS=

# ── Correo SMTP (internal/email) ───────────────
# Se usa SMTP porque el flujo de facturación electrónica requiere adjuntar archivos (ZIP con
# XML firmado + PDF) — los servicios de correo basados solo en API no siempre soportan adjuntos
# binarios de forma fiable. Puerto 587 = STARTTLS (estándar); 465 = TLS implícito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# ── PDF (Chrome headless) ──────────────────────
# Ruta absoluta al binario Chrome o Chromium que usa el generador de PDF.
# Vacío = chromedp busca en PATH automáticamente (funciona en local si Chrome está instalado).
#
# Ubuntu 24 LTS (recomendado — evita el snap de chromium que no funciona headless en VPS):
#   wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
#     && sudo apt-get install -y /tmp/chrome.deb
#   CHROME_PATH=/usr/bin/google-chrome-stable
#
# Ubuntu 20/22 con chromium-browser:
#   sudo apt-get install -y chromium-browser
#   CHROME_PATH=/usr/bin/chromium-browser
#
# Verificar ruta: which google-chrome-stable || which chromium-browser || which chromium
CHROME_PATH=
