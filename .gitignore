# Material real de referencia: certificados, llaves privadas, credenciales DIAN,
# RUT y facturas reales con datos de terceros. Nunca debe llegar al historial de git.
/docs/reference/

# Puente de desarrollo en paralelo entre los módulos cofacture/apidian — es local del
# entorno de quien desarrolla, no parte del código versionado.
/go.work
/go.work.sum

# Credenciales y configuración local
# "**/" al inicio -- sin él, un patrón con "/" en medio (ej. "apidian/.env") queda anclado a la
# raíz del repo y NO cubre variantes anidadas como "_legacy/apidian/.env" (así se filtró un .env
# real al historial de git, ver punto 01 del plan de acción / docs/auditorias).
**/apidian/.env
**/apidian/.env.*
!**/apidian/.env.example
erp/.env
erp/.env.*
!erp/.env.example

# Binarios compilados
apidian.exe
cofacture.exe
*.exe
/bin
/bin/
/dist/

# Test cache y cobertura
*.test
*.out
coverage.html
coverage.txt
server.exe
apidian/server.exe
info.txt

.claude/
